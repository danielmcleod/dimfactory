<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for Dim Factory.app and its helpers (used when the release build signs the app).
  allow-jit: V8 maps its code pages with MAP_JIT, which the hardened runtime refuses without it.
  Deliberately absent: allow-unsigned-executable-memory (only needed by Electron builds without MAP_JIT support),
  disable-library-validation (Dim Factory loads no third-party native modules), allow-dyld-environment-variables.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
