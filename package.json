{
  "name": "dim-factory",
  "productName": "Dim Factory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Runs the AI coding CLIs you already have as one team: plan, build, review and fix, or build a task twice and keep the better result.",
  "homepage": "https://github.com/danielmcleod/dimfactory",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielmcleod/dimfactory.git"
  },
  "bugs": {
    "url": "https://github.com/danielmcleod/dimfactory/issues"
  },
  "author": {
    "name": "The Dim Factory authors"
  },
  "license": "MIT",
  "desktopName": "dim-factory.desktop",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "main": "out/main/index.js",
  "bin": {
    "dimf": "src/cli/dimf.ts",
    "dim-factory": "src/cli/dimf.ts"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "lint": "eslint . --max-warnings 0 && node scripts/check-brand.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:brand": "node scripts/check-brand.mjs",
    "brand:sync": "node scripts/brand-sync.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration --maxWorkers=4",
    "test:renderer": "vitest run --project renderer",
    "test:coverage": "vitest run --project unit --project integration --maxWorkers=4 --coverage \"--coverage.include=src/core/**/*.ts\" \"--coverage.include=src/shared/**/*.ts\"",
    "test:coverage:renderer": "vitest run --project renderer --maxWorkers=4 --coverage \"--coverage.include=src/renderer/src/**/*.{ts,tsx}\"",
    "e2e": "electron-vite build && playwright test",
    "e2e:smoke": "electron-vite build && playwright test --grep @smoke",
    "package:dir": "electron-vite build && electron-builder --dir",
    "package": "electron-vite build && electron-builder",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "soak": "node scripts/soak.mjs",
    "icons:tray": "node scripts/make-tray-icons.mjs",
    "fake-cli": "node scripts/build-fake-cli.mjs",
    "record:raw": "node scripts/record-fixture.mjs",
    "fixture:script": "node scripts/fixture-to-script.mjs",
    "cli": "node src/cli/dimf.ts",
    "postinstall": "install-electron"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.289",
    "@anthropic-ai/sdk": "^0.131.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@pierre/diffs": "1.5.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "jsonc-parser": "3.3.1",
    "lucide-react": "^1.52.0",
    "marked": "18.1.0",
    "prettier": "^3.9.9",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3",
    "zod": "4.6.5",
    "zustand": "^5.0.15"
  }
}
